public class CircleWithFinal {
    public final double redius; // final 필드 선언 (반지름)
    public final double PI = 3.14; // final 필드 선언 (원주율)
    public final double HELLO_WORLD = 1.9; // final 필드 선언 (상수)
}

public CircleWithFinal() {
    redius = 0
}

public CircleWithFinal(double redius) {
    this.redius = redius;
}

// final 상수 필드를 만들 때 쓸 수 있음, 그리고  한번 지정하면 절대 값을 바꿀 수 없음 (재할당 불가)

